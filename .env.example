# Copy this file to .env (same folder) and fill in the key.
# .env is git-ignored: never commit a real key.

# OpenRouter key used by the knowledge assistant (AI-B) to judge and quote
# evidence. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Neon Postgres connection string: holds the knowledge-base chunks and vectors
# (table "rag.document_chunks"). Copy it from the Neon dashboard, Connect button.
# Use sslmode=verify-full; the pooled host (-pooler) is fine.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require

# Optional overrides (defaults shown)
# RAG_ANSWER_MODEL=perplexity/pplx-decider-flash-v1.3:free
# RAG_MIN_SCORE=0.65
# RAG_HIGH_SCORE=0.78
# RAG_TOP_K=4
