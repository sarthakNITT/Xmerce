PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/xmerce_db?schema=public"

# Clerk Auth Credentials
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Frontend origins allowed to call the API with cookies (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Optional: Redis for the search cache (falls back to in-memory if unset)
REDIS_URL=redis://localhost:6379
