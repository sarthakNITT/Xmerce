datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(uuid())
  clerkId          String   @unique
  email            String   @unique
  username         String?  @unique
  firstName        String?
  lastName         String?
  avatarUrl        String?
  authProvider     String   @default("credentials")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([clerkId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())

  @@index([slug])
}

model Product {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  price       Float
  brand       String?
  rating      Float    @default(0.0)
  reviewCount Int      @default(0)
  inStock     Boolean  @default(true)
  stockCount  Int      @default(0)
  images      String[]
  tags        String[]
  color       String?

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([brand])
  @@index([color])
  @@index([price])
  @@index([rating])
  @@index([inStock])
}
